# RAG backend and model settings (read by rag/config.py).
RAG_HOST=127.0.0.1
RAG_PORT=8000
# Optional Vite proxy override, e.g. http://127.0.0.1:8010.
# RAG_PROXY_TARGET=
# Local vLLM defaults are used unless OpenRouter is selected below.
# VLLM_BASE=http://127.0.0.1:8001/v1
# VLLM_MODEL=tomaris
# For OpenRouter, set its model and server-side API key. Unless VLLM_BASE and
# VLLM_MODEL are explicitly set, the backend selects its OpenAI-compatible API.
# OPENROUTER_MODEL=provider/model
# OPENROUTER_API_KEY=
MODEL_TIMEOUT_SECONDS=120
QUERY_DEVICE=cpu
BUILD_DEVICE=cpu

# Optional TTS for the /conference speaker page. Without a key, the browser
# uses its built-in speech synthesis and simulated mouth movement.
TTS_PROVIDER=openai
OPENAI_TTS_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
# To use ElevenLabs, set TTS_PROVIDER=elevenlabs and provide both values.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Public browser-chat limits and CORS. For a same-origin production deployment,
# keep CORS_ORIGINS empty or set it to the exact frontend origins.
PUBLIC_CHAT_RATE_LIMIT=10
PUBLIC_CHAT_RATE_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin console username/password. Generate the PBKDF2 hash with:
#   python rag/admin_security.py hash-password
# Generate a separate signing secret with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep all values server-side; never use VITE_*.
HUQUQ_ADMIN_USERNAME=
HUQUQ_ADMIN_PASSWORD_HASH=
HUQUQ_ADMIN_SESSION_SECRET=
HUQUQ_ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_LOGIN_RATE_LIMIT=5
ADMIN_LOGIN_RATE_WINDOW_SECONDS=60

# Full question/answer logs are never recorded. When enabled, only request
# metadata (mode, citation count, elapsed time) is written to CHAT_LOG.
CHAT_LOG_ENABLED=false
CHAT_LOG=/workspace/chat-metadata.jsonl

# Optional non-secret browser API path. Do not put API keys in VITE_* variables.
# VITE_CHAT_ENDPOINT=/api/chat/completions

# TOMARIS_API_KEYS is intentionally omitted: it is a server-only secret and is
# not required by the same-origin browser-chat endpoint.
